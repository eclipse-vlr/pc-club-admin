APP_ENV=test
HTTP_ADDR=127.0.0.1:8080
CLUB_TIMEZONE=Europe/Moscow
CASH_POLICY_STATUS=unverified
DATABASE_URL=postgres://pcclub:local-development-only@localhost:5432/pcclub?sslmode=disable
POSTGRES_USER=pcclub
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=pcclub
WEB_DIST_DIR=web/dist
APP_ORIGIN=http://127.0.0.1:8080
# Generate once locally; keep outside Git and back it up securely. Never use this comment as a secret.
PIN_PEPPER=
# Optional server-side XLSX synchronization. Only test mode is supported.
DRIVE_EXCEL_SYNC=disabled
DRIVE_EXCEL_FILE_ID=
# Path outside the repository; never paste or commit the service-account JSON.
DRIVE_EXCEL_CREDENTIALS_FILE=
